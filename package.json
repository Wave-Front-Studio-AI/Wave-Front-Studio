{
  "name": "wavefront-studio-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "check": "eslint src",
    "quote:test": "node --test src/quotePdf.test.mjs src/packageQuote.test.mjs",
    "leads": "node --env-file-if-exists=.env server/lead-service.mjs",
    "leads:test": "node --test server/test/*.test.mjs",
    "blog:check": "node blog-agent/validate-post.mjs",
    "blog:audit": "node blog-agent/validate-post.mjs --live",
    "blog:publish": "node blog-agent/publish-post.mjs",
    "cards": "node scripts/make-post-cards.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "jspdf": "4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.3"
  }
}
